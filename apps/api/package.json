{
  "name": "@tactical-board/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit false --outDir dist",
    "test": "tsx --test src/*.test.ts src/providers/*.test.ts src/auth/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@tactical-board/contracts": "workspace:*",
    "@tactical-board/domain": "workspace:*",
    "dotenv": "^18.0.7",
    "fastify": "^5.6.2",
    "google-auth-library": "^11.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
